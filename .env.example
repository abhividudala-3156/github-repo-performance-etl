# ---------------------------------------------------------------------------
# .env.example  -  TEMPLATE ONLY. Never put real passwords in this file.
#
# HOW TO USE (Windows PowerShell):
#   1. Copy this file:      Copy-Item .env.example .env
#   2. Open .env and fill in YOUR local PostgreSQL password (and token if any).
#   3. .env is listed in .gitignore, so it will never be pushed to GitHub.
# ---------------------------------------------------------------------------

# --- Local PostgreSQL connection (created in pgAdmin) ----------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=GIT
DB_USER=postgres
DB_PASSWORD=Abhi@1405

# --- Optional GitHub Personal Access Token ---------------------------------
# Leave empty to use unauthenticated access (60 requests/hour only).
# With a token the limit becomes 5000 requests/hour.
# Create one at: GitHub -> Settings -> Developer settings -> Personal access tokens
# (a classic token with no scopes is enough for public data)
GITHUB_TOKEN=
